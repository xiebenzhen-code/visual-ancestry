# Visual Ancestry —— 环境变量示例
#
# 复制为 .env 并按需填写。**全部只在服务端进程里生效**：
# 构建产物（dist/）不包含任何 VISION_* 值，browser bundle 也读不到它们。
#
# 三个变量都不填时产品照常运行：本地检索、远程渠道、CREATE、SHOOT、记忆都可用；
# 只有「上传图片 / 看图」这一条会明确报「服务端未配置真实识图模型」，
# 不会伪装成识图成功。

# 上游视觉服务的 OpenAI 兼容接口地址（仅服务端）
# 例：https://api.openai.com/v1/chat/completions
VISION_API_BASE=

# 上游密钥。绝不要写进任何会被提交或构建的文件。
VISION_API_KEY=

# 视觉模型 ID。不填则用代码默认值 gpt-4o-mini。
# 注意：部分第三方兼容接口只接受 json_object，不接受 json_schema；
# 适配器只对 DeepSeek 主机名做了特判，换 provider 前请先用一次最小请求验证。
VISION_MODEL=

# ---- 访问控制（可选但强烈建议）----
# 两者必须同时设置，否则服务端拒绝启动；secret 至少 32 字符。
# 设置后 POST /api/vision 需要先用访问码换 session token。
# VISION_ACCESS_CODE=
# VISION_ACCESS_SECRET=

# ---- 预算账本（强烈建议）----
# Provider 已配置而此变量缺失时，Bridge 会**拒绝调用**（fail-closed），
# 不会因为「没配预算」而放开付费 Key。
# VISION_BUDGET_FILE=C:/path/to/vision-budget.ndjson
# VISION_BUDGET_DAILY=200
# VISION_BUDGET_TOTAL=2000
# VISION_MAX_CONCURRENT=2

# ---- 本轮实验用（一般不需要）----
# 关闭 provider 内部静默重试
# VISION_NO_RETRY=1
# 本轮实际请求尝试次数硬上限（0 = 不限制）
# VISION_ROUND_CALL_LIMIT=4

# ---- 自动发现（可选）----
# TMDB 只允许服务端持有；浏览器端不直连，也不会把 Token 放进 URL。
# 未配置时该来源标记为 credential-required，其余来源照常工作。
TMDB_READ_ACCESS_TOKEN=
